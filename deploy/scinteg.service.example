[Unit]
Description=Scinteg anonymous reporting service
After=network.target mongod.service

[Service]
Type=simple
User=scinteg
Group=scinteg
WorkingDirectory=/opt/scinteg/app
ExecStart=/opt/scinteg/node-v24.11.0-linux-x64/bin/node --env-file=/etc/scinteg.env server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=210
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/scinteg

[Install]
WantedBy=multi-user.target
