[Unit]
Description=Scinteg anonymous reporting service
After=network.target mongod.service

[Service]
Type=simple
User=scinteg
Group=scinteg
WorkingDirectory=/opt/scinteg/app
ExecStart=/opt/scinteg/node-v24.22.3-linux-x64/bin/node scripts/run.js start --env-file /etc/scinteg.env
Environment=NODE_ENV=production
Restart=on-failure
RestartSec=5
TimeoutStopSec=210
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Set DATA_DIR in /etc/scinteg.env inside this path, e.g. DATA_DIR=/var/lib/scinteg/data
ReadWritePaths=/var/lib/scinteg

[Install]
WantedBy=multi-user.target
