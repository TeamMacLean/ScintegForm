{
  "name": "scintegform",
  "version": "2.0.0",
  "description": "Anonymous scientific misconduct reporting",
  "author": "George Deeks",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "node scripts/check.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "test:delivery": "node --env-file-if-exists=.env scripts/test-delivery.js",
    "test:mail:vpn": "node --env-file-if-exists=.env scripts/test-vpn-mail.js",
    "test:scanner": "node --env-file-if-exists=.env scripts/check-scanner.js",
    "dev:mail": "node scripts/dev-mail.js",
    "dev:scanner:setup": "node scripts/setup-clamav.js",
    "test:scanner:dev": "node --test test/clamav.integration.js",
    "notifications": "node --env-file-if-exists=.env scripts/notifications.js",
    "monitor": "node --env-file-if-exists=.env scripts/healthcheck.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "file-type": "22.3.0",
    "helmet": "8.3.0",
    "mongoose": "8.24.11",
    "multer": "2.5.0",
    "nodemailer": "10.6.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "mailparser": "^3.9.0",
    "smtp-server": "^3.16.0",
    "supertest": "^7.1.4",
    "yazl": "3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamMacLean/ScintegForm.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/TeamMacLean/ScintegForm/issues"
  },
  "homepage": "https://github.com/TeamMacLean/ScintegForm#readme",
  "type": "module",
  "engines": {
    "node": "24.11.0"
  }
}
