# Safe local defaults. Copy to .env; never commit credentials or real report data.
HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/scintegform_dev
DATA_DIR=./var/capture
# Production requires an absolute path outside the app directory, e.g. /var/lib/scinteg/data

# capture: private .eml files only; test: ONLY deeks@nbi.ac.uk; production: explicit recipients.
MAIL_MODE=capture
TEST_EMAIL=deeks@nbi.ac.uk
MAIL_FROM=scinteg@tsl.ac.uk
SMTP_HOST=mail.nbi.ac.uk
SMTP_PORT=25
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=

# Required only in production; use full email addresses, not usernames.
# REPORT_RECIPIENTS=
# WEBMASTER_EMAIL=

MAX_FILES=10
MAX_FILE_BYTES=10000000
MAX_TOTAL_BYTES=15000000
MAX_CONCURRENT_UPLOADS=4
MAX_REQUESTS_PER_MINUTE=30
MIN_FREE_BYTES=500000000

# Disabled scanning is allowed only in capture/test modes. Production requires clamav.
UPLOAD_SCAN_MODE=disabled
CLAMSCAN_COMMAND=clamscan
# Optional local signature directory, populated by npm run dev:scanner:setup:
# CLAMAV_DATABASE_DIR=./var/clamav/db
WORKER_INTERVAL_MS=10000
# 60 attempts with backoff capped at one hour retries for about two days.
MAX_MAIL_ATTEMPTS=60

# Anonymous operational samples (memory, event-loop delay, database state).
OPS_LOG_INTERVAL_MS=60000
SLOW_REQUEST_MS=10000
# Monitor the public proxy and local Node process. Use off for public-only monitoring.
# MONITOR_PUBLIC_ORIGIN=https://your-scinteg-host
MONITOR_LOCAL_ORIGIN=http://127.0.0.1:3000
MONITOR_INTERVAL_MS=60000
